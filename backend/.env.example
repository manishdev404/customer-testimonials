# Copy to .env and fill in. Never commit .env — it holds live credentials.

NODE_ENV=development
PORT=4000

# Comma-separated origins allowed to call this API (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000

# --- Firebase Admin service account -----------------------------------------
# From Firebase Console -> Project Settings -> Service Accounts ->
# "Generate new private key". Take these three values from the downloaded JSON.
#
# FIREBASE_PRIVATE_KEY must be wrapped in double quotes and keep its literal
# \n escapes — the app converts them back to real newlines at boot.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"

# Cloud Storage bucket for testimonial images.
# Defaults to <FIREBASE_PROJECT_ID>.firebasestorage.app when unset.
# Creating a bucket requires the Blaze plan; without one the API automatically
# falls back to storing compressed images inline on the Firestore document.
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# --- AI insights ------------------------------------------------------------
# Free key from https://console.groq.com. Leave blank to use the built-in
# heuristic analyser instead — the API works either way.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Seed demo testimonials when the reviews collection is empty.
SEED_ON_EMPTY=true
