# Copy to .env and adjust as needed.
#
# Base URL of the API. Set this to run against the Express + Firestore backend.
# Leave it unset to use the built-in Next.js route handlers instead, which serve
# in-memory demo data and require no Firebase credentials — useful for working
# on the UI standalone.
#
# NOTE: NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
# Never put a secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
